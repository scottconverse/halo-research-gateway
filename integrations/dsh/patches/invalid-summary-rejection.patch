+import { writeFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { expect, it } from 'vitest'
+import { LOADER_SMOKE_TEST_TIMEOUT_MS, runLoaderSmoke } from '@deepseek-ai/dsh-loader-smoke'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import { isReplacementSurfaceEvent } from '@deepseek-ai/dsh-session/surface'
+
+it('preserves research input when the assembled summarizer returns a tool call', async () => {
+  const configPath = fileURLToPath(new URL('../invalid-summary.cordis.snapshot.yml', import.meta.url))
+  const binScript = fileURLToPath(new URL('./fixtures/headless-driver.ts', import.meta.url))
+  const result = await runLoaderSmoke({
+    label: 'invalid summary preserves source history',
+    tempDirPrefix: 'dsh-invalid-summary-',
+    binScript,
+    libBinScript: binScript,
+    configPath,
+    binArgs: [configPath, 'Read marker.txt and preserve the research evidence.'],
+    tsconfigPath: fileURLToPath(new URL('../../../tsconfig.json', import.meta.url)),
+    env: { DSH_SNAPSHOT: 'replay' },
+    prepare: async (cwd) => { await writeFile(join(cwd, 'marker.txt'), 'SOURCE_EVIDENCE_MUST_SURVIVE\n') },
+  })
+  const records = result.stdout.trim().split('\n').map(line => JSON.parse(line) as {
+    type: string
+    event?: SessionEvent
+    output?: string
+  })
+  const events = records.flatMap(record => record.event === undefined ? [] : [record.event])
+  const calls = events.filter(event => event.type === 'tool/call')
+  const results = events.filter(event => event.type === 'tool/result')
+  const end = events.findLast(event => event.type === 'compaction/end')
+  expect(calls).toHaveLength(1)
+  expect(calls[0]?.data).toMatchObject({ name: 'read', arguments: '{"file_path":"marker.txt"}' })
+  expect(JSON.stringify(results)).toContain('SOURCE_EVIDENCE_MUST_SURVIVE')
+  expect(events.some(event => event.type === 'compaction/summary')).toBe(false)
+  expect(events.some(isReplacementSurfaceEvent)).toBe(false)
+  expect(end?.data.error).toContain('tool calls instead of a completed checkpoint')
+  expect({
+    toolCalls: calls.map(event => event.data.name),
+    compactionError: end?.data.error,
+    terminalReason: events.findLast(event => event.type === 'turn/end')?.data.reason,
+    output: records.at(-1)?.output,
+  }).toMatchInlineSnapshot(`
+    {
+      "compactionError": "summarization returned tool calls instead of a completed checkpoint",
+      "output": "",
+      "terminalReason": {
+        "error": {
+          "code": "CONTEXT_WINDOW_EXCEEDED",
+          "message": "fixture requires compaction before continuation",
+        },
+        "kind": "error",
+      },
+      "toolCalls": [
+        "read",
+      ],
+    }
+  `)
+}, LOADER_SMOKE_TEST_TIMEOUT_MS)
