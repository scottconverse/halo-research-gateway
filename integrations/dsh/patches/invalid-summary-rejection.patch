@@ -0,0 +1,39 @@
+/** Keyless malformed-summary provider; tool execution remains the real file reader. */
+import type { Context } from '@deepseek-ai/cordis'
+import { CallId, LlmAdapter, type GenerateOptions, type LlmResolvedModelInfo, type StreamChunk } from '@deepseek-ai/dsh-llm'
+
+class InvalidSummaryAdapter extends LlmAdapter {
+  override async resolveModel(provider: string, model: string): Promise<LlmResolvedModelInfo> {
+    return { provider, id: model, name: model, context: { contextWindow: 128000 } }
+  }
+
+  override async * stream(options: GenerateOptions): AsyncIterable<StreamChunk> {
+    if (options.purpose !== 'compaction'
+      && options.messages.some(message => message.content.some(block => block.type === 'tool-result'))) {
+      yield { type: 'finish', reason: { kind: 'error', failure: {
+        code: 'CONTEXT_WINDOW_EXCEEDED', message: 'fixture requires compaction before continuation',
+      } } }
+      return
+    }
+    if (options.purpose === 'compaction') {
+      yield { type: 'block-start', index: 0, blockType: 'text' }
+      yield { type: 'text-delta', index: 0, text: 'The page is incomplete. Let me continue fetching.' }
+      yield { type: 'block-end', index: 0, block: { type: 'text', text: 'The page is incomplete. Let me continue fetching.' } }
+    }
+    const index = options.purpose === 'compaction' ? 1 : 0
+    const id = CallId(options.purpose === 'compaction' ? 'summary-must-not-execute' : 'source-read')
+    const args = JSON.stringify({ file_path: options.purpose === 'compaction' ? 'never-read.txt' : 'marker.txt' })
+    yield { type: 'block-start', index, blockType: 'tool-call' }
+    yield { type: 'tool-call-delta', index, id, name: 'read', argumentsDelta: args }
+    yield { type: 'block-end', index, block: { type: 'tool-call', id, name: 'read', arguments: args } }
+    yield { type: 'finish', reason: { kind: 'tool-calls' } }
+  }
+}
+
+export const name = 'invalid-summary-model'
+export const inject = ['llm']
+
+/** Register only the deterministic provider in this test composition. */
+export function apply(ctx: Context): void {
+  ctx.llm.registerAdapter(['deepseek-official'], new InvalidSummaryAdapter())
+}
