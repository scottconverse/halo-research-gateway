+/** Logged background material for the keyless compaction recovery scenario. */
+import type { Context } from '@deepseek-ai/cordis'
+import type { PreStepDecision } from '@deepseek-ai/dsh-agent'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+
+export const name = 'compaction-context-fixture'
+export const inject = ['agents']
+
+/** Add reducible context without inflating or replacing the user's request. */
+export function apply(ctx: Context): void {
+  ctx.on('agent/pre-step', async ({ step }, next): Promise<PreStepDecision> => {
+    const decision = await next()
+    if (decision.kind === 'reject' || step !== 1) return decision
+    return {
+      kind: 'enter',
+      messages: [...decision.messages, createUserMessage({
+        content: [{ type: 'text', text: Array.from({ length: 24 }, (_, index) =>
+          `Background record ${index + 1}: the fixture stores tool evidence separately from user instructions. Completed tool results remain paired with their calls, and checkpoint replacement can summarize these background records without changing the request.`).join('\n') }],
+        source: { kind: 'plugin', plugin: name },
+      })],
+    }
+  }, { prepend: true })
+}
