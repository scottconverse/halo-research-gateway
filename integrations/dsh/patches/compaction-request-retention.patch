+/**
+ * Preserve the current turn's latest admitted user input only when this span
+ * contains it or its checkpoint descendant. Completed turns remain summarizable.
+ * Plugin context and generated summaries never supply authoritative request
+ * text. Request content and call count share the pre-summarization snapshot.
+ */
+function retainUserRequest(
+  session: Session,
+  shadowedSeqs: readonly number[],
+): PreparedCompaction['retainedRequest'] {
+  const events = session.events
+  const turn = events.findLast(event => event.type === 'turn/start' || event.type === 'turn/end')
+  if (turn?.type !== 'turn/start') return undefined
+  const request = events.findLast(event => event.type === 'user/message'
+    && event.data.source.kind === 'user' && event.surfaceOp !== undefined)
+  if (request === undefined || request.type !== 'user/message' || request.seq < turn.seq) return undefined
+  if (session.surface.nodes.includes(request.seq) && !shadowedSeqs.includes(request.seq)) return undefined
+
+  const pending = [...shadowedSeqs]
+  const visited = new Set<number>()
+  let containsRequest = false
+  for (let seq = pending.pop(); seq !== undefined; seq = pending.pop()) {
+    if (seq === request.seq) {
+      containsRequest = true
+      break
+    }
+    if (visited.has(seq)) continue
+    visited.add(seq)
+    const event = events[seq]
+    if (event?.type === 'user/message' && isCompactCheckpointSource(event.data.source)) {
+      pending.push(...event.sourceEventSeqs ?? [])
+    }
+  }
+  if (!containsRequest) return undefined
+
+  let calls = 0
+  for (let index = request.seq + 1; index < events.length; index += 1) {
+    if (events[index]?.type === 'tool/call') calls += 1
+  }
+  return {
+    seq: request.seq,
+    content: [
+      { type: 'text', text: 'Current-turn user request (verbatim; overrides summary):\n<retained-user-request>' },
+      ...request.data.content,
+      { type: 'text', text: `</retained-user-request>\nRecorded tool calls since this request: ${calls} (all tools through checkpoint preparation, including retained-history calls and failed attempts). Later user messages take precedence.` },
+    ],
   }
 }
 
